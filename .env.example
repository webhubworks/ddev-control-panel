APP_NAME="DDEV Control Panel"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

NATIVEPHP_APP_ID=de.webhub.ddev-control-panel
NATIVEPHP_APP_AUTHOR="webhub GmbH"
NATIVEPHP_APP_DESCRIPTION="Start, stop and inspect your ddev projects from the macOS menu bar."
# Bump this whenever a migration is added, otherwise a packaged build keeps
# running against the old schema and fails with a bare 500 Server Error.
NATIVEPHP_APP_VERSION=0.0.4

# electron-builder only gets a publish target when the updater is enabled, so
# `native:build --publish` does nothing useful with this off.
NATIVEPHP_UPDATER_ENABLED=true
NATIVEPHP_UPDATER_PROVIDER=github
GITHUB_OWNER=webhubworks
GITHUB_REPO=ddev-control-panel
# Releases land as drafts, so a build is never public until it is published by
# hand in the GitHub UI.
GITHUB_RELEASE_TYPE=draft
# Needs `repo` scope. GITHUB_* is in cleanup_env_keys so it never reaches a
# packaged build, but prefer exporting it for the build over storing it here:
#   export GITHUB_TOKEN=$(gh auth token)
GITHUB_TOKEN=

# Absolute path to the ddev executable. Leave unset to auto-detect.
# DDEV_BINARY_PATH=/opt/homebrew/bin/ddev

# Absolute path to the docker executable, used for the event stream that keeps
# the project list current. Leave unset to auto-detect.
# DOCKER_BINARY_PATH=/usr/local/bin/docker

# Set to false to stop listening to Docker and fall back to refreshing only
# when the popup is opened.
# DDEV_WATCH_ENABLED=true
